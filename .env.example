# Copy to .env.local for local development. Never commit real values.
# All of these are server-only: never prefix them with NEXT_PUBLIC_.

# Local Docker DB (see docker-compose.yml). For Aiven, use the service URI from
# the Aiven console, e.g. postgresql://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
DATABASE_URL=postgresql://alpha_scout:alpha_scout@localhost:5432/alpha_scout

# PEM contents of the Aiven project CA certificate (Aiven console > Service > Overview >
# "CA certificate"). Required for TLS verification against Aiven; leave unset locally.
DATABASE_CA_CERT=

# Vercel AI Gateway. On Vercel deployments, OIDC is used automatically and this is
# not needed. Locally, either set a key here or run `vercel env pull` to get an OIDC token.
AI_GATEWAY_API_KEY=

# Gateway model ID ("provider/model"). Intentionally unset until a model is chosen.
AI_MODEL_ID=
